# Description: Linux-native fakeroot using user namespaces
# URL: https://github.com/rootless-containers/rootlesskit
# Maintainer: Juergen Daubert, jue at crux dot nu
# Arch Maintainer: CRUX-RISCV System Team, devel at crux-riscv dot nu

name=rootlesskit-bin
version=3.0.0
release=1
source=(https://github.com/rootless-containers/rootlesskit/releases/download/v$version/rootlesskit-riscv64.tar.gz)
renames=(rootlesskit-$version-riscv64.tar.gz)

build() {
    install -d $PKG/usr/bin
    install rootlesskit $PKG/usr/bin
    ln -s rootlesskit $PKG/usr/bin/rlk
}
